{
  "expo": {
    "name": "GymUp",
    "slug": "gym-up",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gymup",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0E14"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/94b18bb2-7e0b-44e1-9707-39c09eb852d9"
    },
    "plugins": ["expo-router", "expo-updates"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bfukumori.gymup"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0E14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bfukumori.gymup"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94b18bb2-7e0b-44e1-9707-39c09eb852d9"
      }
    },
    "owner": "bfukumori"
  }
}
