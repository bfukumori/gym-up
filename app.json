{
  "expo": {
    "name": "GymUp",
    "slug": "gym-up",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gymup",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/94b18bb2-7e0b-44e1-9707-39c09eb852d9"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0E14"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366F1",
          "defaultChannel": "workout-reminders"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bfukumori.gymup"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#102020",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bfukumori.gymup",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["RECEIVE_BOOT_COMPLETED", "SCHEDULE_EXACT_ALARM", "POST_NOTIFICATIONS"]
    },
    "androidStatusBar": {
      "backgroundColor": "#0B0E14",
      "barStyle": "light-content",
      "translucent": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#0B0E14",
      "barStyle": "light-content"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94b18bb2-7e0b-44e1-9707-39c09eb852d9"
      }
    },
    "owner": "hyumin-it"
  }
}
